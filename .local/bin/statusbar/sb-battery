#!/bin/sh
# Prints all batteries, their percentage remaining and an icon corresponding
# to charge status (󰂄 for plugged up, 󰁹 for discharging on battery, etc.).
case $BLOCK_BUTTON in
	3) notify-send "󰁹 Battery module" "󰁹: discharging
󰂑: not charging
󰂊: stagnant charge
󰂄: charging
󰂅: charged
󰂃: battery very low!
- Scroll to adjust xbacklight." ;;
	4) xbacklight -inc 10 ;;
	5) xbacklight -dec 10 ;;
	6) setsid -f "$TERMINAL" -e "$EDITOR" "$0" ;;
esac
for battery in /sys/class/power_supply/BAT?*; do
	[ -n "${capacity+x}" ] && printf " "
	case "$(cat "$battery/status" 2>&1)" in
		"Full")        status="^c#00FF00^󰂅^d^" ;;
		"Discharging") status="^c#e4d8d2^󰁹^d^" ;;
		"Charging")    status="^c#FFD700^󰂄^d^" ;;
		"Not charging") status="^c#9f9793^󰂑^d^" ;;
		"Unknown")     status="^c#9f9793^󰂊^d^" ;;
		*) exit 1 ;;
	esac
	capacity="$(cat "$battery/capacity" 2>&1)"
	[ "$status" = "^c#e4d8d2^󰁹^d^" ] && [ "$capacity" -le 25 ] && status="^c#FF0000^󰂃^d^"
	printf "%s %d%%" "$status" "$capacity"
done && printf "\\n"
